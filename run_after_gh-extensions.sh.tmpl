{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

if ! command -v gh >/dev/null 2>&1; then
  echo "WARNING: gh is not installed; skipping GitHub CLI extensions" >&2
  exit 0
fi

# With no --pin, --force installs or upgrades to the latest release.
gh extension install dlvhdr/gh-dash --force
{{- end -}}
