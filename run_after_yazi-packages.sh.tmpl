{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

if ! command -v ya >/dev/null 2>&1; then
  echo "WARNING: Yazi is not installed; skipping flavor installation" >&2
  exit 0
fi

if ! ya pkg list 2>/dev/null | grep -Fq 'BennyOe/tokyo-night'; then
  ya pkg add BennyOe/tokyo-night
fi
ya pkg upgrade BennyOe/tokyo-night
{{- end -}}
