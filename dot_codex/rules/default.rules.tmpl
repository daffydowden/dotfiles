# Signed commits need access to the protected .git directory and 1Password's
# local signing socket. Limit the sandbox exception to this trusted repository.
prefix_rule(
    pattern = [
        "git",
        "-C",
        "{{ .chezmoi.sourceDir }}",
        "commit",
    ],
    decision = "allow",
    justification = "Allow signed commits in the trusted dotfiles repository",
    match = [
        "git -C {{ .chezmoi.sourceDir }} commit -m 'Update dotfiles'",
    ],
    not_match = [
        "git -C {{ .chezmoi.sourceDir }} push origin main",
        "git -C {{ .chezmoi.homeDir }}/projects/example commit -m 'Update project'",
    ],
)
