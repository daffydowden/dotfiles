{{- if and (eq .chezmoi.os "darwin") (not .is_work) -}}
#!/usr/bin/env fish

# Pulls personal API keys out of 1Password into universal fish variables, so the
# tools that expect them as plain env vars (nvim's parrot/codecompanion, the `ai`
# wrapper) don't need a vault round-trip on every shell start.

set -g LOG_FILE "$HOME/.1password_script.log"
set -g OP_VAULT Personal

echo "=== Script started at $(date) ===" >"$LOG_FILE"

function log
    echo "$argv" | tee -a "$LOG_FILE"
end

# --- Migration leftovers from the Dashlane setup --------------------------

if set -q DASHLANE_SERVICE_DEVICE_KEYS
    log "Clearing stale DASHLANE_SERVICE_DEVICE_KEYS universal variable"
    set -e -U DASHLANE_SERVICE_DEVICE_KEYS
end
rm -f "$HOME/.dashlane_script.log"

# --- Preflight ------------------------------------------------------------

for cmd in op jq
    if not command -q $cmd
        log "$cmd not found — it is installed by the Brewfile."
        log "Re-run 'chezmoi apply' once package installation has finished."
        exit 1
    end
end

# --- Item lookup ----------------------------------------------------------

# This doubles as the auth check. `op whoami` is no good for that: under desktop
# app integration it reports "account is not signed in" until some other request
# has woken the session, so it always fails on the first call of a session.
#
# Titles alone aren't unique either — the Personal vault holds both an API
# Credential and a Login called "Groq", and `op read` refuses to guess between
# them. Listing a single category gives an unambiguous title → item ID map.
if not set -g OP_ITEMS (op item list --vault $OP_VAULT --categories "API Credential" --format json 2>>"$LOG_FILE")
    log "=============================================================="
    log "Could not read the '$OP_VAULT' vault from 1Password"
    log "=============================================================="
    log ""
    log "Usually this means the CLI isn't authenticated yet:"
    log ""
    log "1. Open the 1Password desktop app and unlock it."
    log "2. Turn on Settings → Developer → 'Integrate with 1Password CLI'"
    log "   (and 'Biometric unlock for 1Password CLI' while you're there)."
    log "3. Check it took:"
    log "   op vault list"
    log ""
    log "   Without the desktop app, run 'op signin' instead."
    log ""
    log "4. Run 'chezmoi apply' again to continue setup."
    log ""
    log "If you are signed in, check that a vault named '$OP_VAULT' exists."
    log "The underlying error is at the end of $LOG_FILE."
    log "=============================================================="

    # Non-zero so chezmoi surfaces that manual action is needed.
    exit 1
end

# Prints the item ID for an exact title match, or nothing if zero or several
# items match.
function item_id --argument-names title
    printf '%s\n' $OP_ITEMS | jq -r --arg t "$title" \
        '[.[] | select(.title == $t) | .id] | if length == 1 then .[0] else empty end'
end

function check_and_set_key --argument-names key_name item_title
    # Existing values win, so a rotated key in 1Password won't propagate on its
    # own. Re-pull everything with: OP_REFRESH_KEYS=1 chezmoi apply
    if not set -q OP_REFRESH_KEYS; and set -q $key_name; and test -n "$$key_name"
        log "$key_name already set, skipping"
        return 0
    end

    set -l id (item_id "$item_title")
    if test -z "$id"
        log "  Error: no single 'API Credential' titled '$item_title' in $OP_VAULT"
        return 1
    end

    # Deliberately not silencing stderr: a failed read belongs in the log rather
    # than quietly leaving the variable unset.
    if not set -l value (op read "op://$OP_VAULT/$id/credential" 2>>"$LOG_FILE")
        log "  Error: could not read the credential for '$item_title' — see $LOG_FILE"
        return 1
    end
    if test -z "$value"
        log "  Error: the credential for '$item_title' is empty"
        return 1
    end

    set -Ux $key_name $value
    log "Set $key_name from '$item_title'"
end

log "Checking API keys..."

set -g failed 0
for pair in \
    "OPENAI_API_KEY:OpenAI" \
    "ANTHROPIC_API_KEY:Anthropic" \
    "DEEPSEEK_API_KEY:Deepseek" \
    "OPENROUTER_API_KEY:OpenRouter" \
    "GOOGLE_AI_API_KEY:Google AI" \
    "GROQ_API_KEY:Groq"

    set -l parts (string split -m 1 ':' $pair)
    if not check_and_set_key $parts[1] "$parts[2]"
        set failed (math $failed + 1)
    end
end

log "=== Script completed at $(date) ==="

if test $failed -gt 0
    log "$failed key(s) could not be set — see $LOG_FILE"
    exit 1
end

{{ end -}}
