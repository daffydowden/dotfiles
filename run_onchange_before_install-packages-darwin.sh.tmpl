{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -euo pipefail

if ! command -v brew >/dev/null 2>&1; then
  printf 'chezmoi: Homebrew is required before package installation\n' >&2
  exit 1
fi

# Current Homebrew requires an explicit trust decision before loading formulae
# from third-party taps. These are the same taps declared in the Brewfile below.
for tap in \
  trycua/lume \
  d12frosted/emacs-plus \
  charmbracelet/tap \
  {{ if .is_work -}}
  schpet/tap
  {{- else -}}
  openhue/cli
  {{- end }}; do
  brew trust "$tap"
done

# Retire the link ownership from the previous Emacs distribution without
# uninstalling it; this is reversible with `brew link emacs-mac@29`.
if brew list --formula emacs-mac@29 >/dev/null 2>&1; then
  brew unlink emacs-mac@29
fi

# The rendered Brewfile is embedded so run_onchange tracks package/profile
# changes, while ~/.Brewfile is also deployed for normal `brew bundle` use.
brew bundle --no-upgrade --file=/dev/stdin <<'BREWFILE'
{{ template "Brewfile.tmpl" . -}}
BREWFILE
{{ end -}}
