if status is-interactive
    # Commands to run in interactive sessions can go here
end

set fish_greeting

set EZA_CONFIG_DIR ~/.config/eza

fish_add_path ~/bin
fish_add_path /opt/homebrew/bin
fish_add_path /opt/homebrew/sbin
fish_add_path ~/.local/bin
fish_add_path ~/.krew/bin

{{- if .is_work }}

set -gx SRC_ENDPOINT (string decode base64 '{{ .src_endpoint | b64enc }}')
set -gx JIRA_USER (string decode base64 '{{ .jira_user | b64enc }}')
fish_add_path (string decode base64 '{{ .work_bin_path | b64enc }}')

eval (ai-env)

# Refresh the work-only, repository-prefix filters before launching gh-dash.
# --wraps keeps gh's normal Fish completions while all other gh commands pass
# straight through to the real executable.
function gh --wraps gh
    if test (count $argv) -gt 0; and test "$argv[1]" = dash
        gh-dash-work $argv[2..-1]
    else
        command gh $argv
    end
end
{{- end }}

set -gx EDITOR nvim

alias grep 'ug'

# A Herdr session can be launched from cmux and inherit its CMUX_* variables.
# Once Herdr has established its own pane context, treat that as authoritative:
# otherwise both Pi integrations can fire and the Claude shim can re-enter cmux.
if set -q HERDR_ENV; and test "$HERDR_ENV" = 1
    for variable in (set --names | string match 'CMUX_*')
        set --erase "$variable"
    end
    set --erase variable
end

# Claude Code
if set -q HERDR_ENV; and test "$HERDR_ENV" = 1; and set -q HERDR_PANE_ID; and command -q herdmates
    function claude
        herdmates teammux-launch $argv
    end
    alias c 'claude --dangerously-skip-permissions'
else if set -q CMUX_WORKSPACE_ID
    alias c 'cmux claude-teams --dangerously-skip-permissions'
    alias claude 'cmux claude-teams --dangerously-skip-permissions'
    alias claude-teams 'cmux claude-teams'
    alias cy 'command claude --dangerously-skip-permissions'
else
    alias c 'command claude --dangerously-skip-permissions'
    alias claude 'command claude --dangerously-skip-permissions'
end

set fish_cursor_default block
starship init fish | source

if test -d ~/.cache/lm-studio/bin
    fish_add_path ~/.cache/lm-studio/bin
end

zoxide init fish | source

if command -v wt >/dev/null 2>&1; eval (command wt config shell init fish); end

{{- if .is_work }}
# cmux persists this per-surface marker in its session manifest. Clear it before
# launching so a subshell opened from the TUI does not recursively relaunch it.
if status is-interactive; and set -q CMUX_STARTUP_APP
    set -l cmux_startup_app "$CMUX_STARTUP_APP"
    set --erase CMUX_STARTUP_APP
    switch "$cmux_startup_app"
        case ltui
            command ltui
        case gh-dash
            gh dash
    end
    set --erase cmux_startup_app
end
{{- end }}
