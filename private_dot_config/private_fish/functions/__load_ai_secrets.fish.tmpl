function __load_ai_secrets -d "Load AI credentials into this Fish process"
    set -l quiet 0
    if test (count $argv) -gt 0; and test "$argv[1]" = --quiet
        set quiet 1
    end

{{- if .is_work }}
    if not command -q chezmoi; or not command -q keeper
        test $quiet -eq 0; and echo "load-ai-secrets: chezmoi and keeper are required" >&2
        return 1
    end

    set -l keys SRC_ACCESS_TOKEN JIRA_TOKEN LITE_LLM_API_KEY
    set -l records sourcegraph_access_token jira_token 'LiteLLM API Key'
    set -l failures 0
    for index in (seq (count $keys))
        set -l key $keys[$index]
        set -q $key; and test -n "$$key"; and continue
        set -l record $records[$index]
        set -l value (chezmoi execute-template "{{ "{{" }} keeperFindPassword \"$record\" {{ "}}" }}" 2>/dev/null)
        if test -n "$value"
            set -gx $key "$value"
        else
            set failures (math $failures + 1)
            test $quiet -eq 0; and echo "load-ai-secrets: Keeper record '$record' was unavailable" >&2
        end
    end
{{- else }}
    if not command -q op; or not command -q jq
        test $quiet -eq 0; and echo "load-ai-secrets: op and jq are required" >&2
        return 1
    end

    set -l items (op item list --vault Personal --categories 'API Credential' --format json 2>/dev/null | string collect)
    if test -z "$items"
        test $quiet -eq 0; and echo "load-ai-secrets: unlock 1Password and enable CLI integration" >&2
        return 1
    end

    set -l pairs \
        OPENAI_API_KEY:OpenAI \
        ANTHROPIC_API_KEY:Anthropic \
        DEEPSEEK_API_KEY:Deepseek \
        OPENROUTER_API_KEY:OpenRouter \
        'GOOGLE_AI_API_KEY:Google AI' \
        GROQ_API_KEY:Groq
    set -l failures 0
    for pair in $pairs
        set -l parts (string split -m 1 ':' -- $pair)
        set -l key $parts[1]
        set -l title $parts[2]
        set -q $key; and test -n "$$key"; and continue

        set -l id (printf '%s\n' "$items" | jq -r --arg title "$title" \
            '[.[] | select(.title == $title) | .id] | if length == 1 then .[0] else empty end')
        set -l value
        test -n "$id"; and set value (op read "op://Personal/$id/credential" 2>/dev/null)
        if test -n "$value"
            set -gx $key "$value"
        else
            set failures (math $failures + 1)
            test $quiet -eq 0; and echo "load-ai-secrets: '$title' was unavailable" >&2
        end
    end
{{- end }}

    test $failures -eq 0
end
