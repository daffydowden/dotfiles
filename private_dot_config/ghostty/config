# Small overrides on top of Ghostty's built-in Tokyo Night theme.
copy-on-select = false

theme = tokyonight
cursor-style = block
cursor-style-blink = true
shell-integration-features = sudo,title,no-cursor

font-thicken = true
font-family = FiraCode Nerd Font Mono Retina
macos-titlebar-style = tabs

macos-option-as-alt = left
