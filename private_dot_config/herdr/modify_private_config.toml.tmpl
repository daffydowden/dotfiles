#!/usr/bin/env bash
# Preserve Herdr's runtime-managed settings while maintaining our Tokyo Night
# theme, plugin UI, and the graphics support required by herdr-browser.
set -euo pipefail

current="$(cat)"
current="$(printf '%s\n' "$current" | awk '
  /^# BEGIN CHEZMOI: herdr plugins$/ { managed = 1; next }
  /^# END CHEZMOI: herdr plugins$/   { managed = 0; next }
  !managed { print }
')"

current="$(printf '%s\n' "$current" | awk '
  function ensure_kitty_graphics() {
    if (in_experimental && !wrote_kitty_graphics) {
      print "kitty_graphics = true"
      wrote_kitty_graphics = 1
    }
  }

  /^[[:space:]]*\[experimental\][[:space:]]*$/ {
    in_experimental = 1
    saw_experimental = 1
    print
    next
  }

  /^[[:space:]]*\[/ {
    ensure_kitty_graphics()
    in_experimental = 0
    print
    next
  }

  in_experimental && /^[[:space:]]*kitty_graphics[[:space:]]*=/ {
    if (!wrote_kitty_graphics) {
      print "kitty_graphics = true"
      wrote_kitty_graphics = 1
    }
    next
  }

  { print }

  END {
    ensure_kitty_graphics()
    if (!saw_experimental) {
      print ""
      print "[experimental]"
      print "kitty_graphics = true"
    }
  }
')"

current="$(printf '%s\n' "$current" | awk '
  function ensure_theme_name() {
    if (in_theme && !wrote_theme_name) {
      print "name = \"tokyo-night\""
      wrote_theme_name = 1
    }
  }

  /^[[:space:]]*\[theme\][[:space:]]*$/ {
    in_theme = 1
    saw_theme = 1
    print
    next
  }

  /^[[:space:]]*\[/ {
    ensure_theme_name()
    in_theme = 0
    print
    next
  }

  in_theme && /^[[:space:]]*name[[:space:]]*=/ {
    if (!wrote_theme_name) {
      print "name = \"tokyo-night\""
      wrote_theme_name = 1
    }
    next
  }

  { print }

  END {
    ensure_theme_name()
    if (!saw_theme) {
      print ""
      print "[theme]"
      print "name = \"tokyo-night\""
    }
  }
')"

printf '%s\n' "$current"
cat <<'EOF'

# BEGIN CHEZMOI: herdr plugins
[[keys.command]]
key = "prefix+shift+g"
type = "plugin_action"
command = "worktrunk.open"
description = "Worktree: switch / create from default branch"

[[keys.command]]
key = "prefix+shift+c"
type = "plugin_action"
command = "worktrunk.open-current"
description = "Worktree: switch / create from current branch"

[[keys.command]]
key = "prefix+shift+d"
type = "plugin_action"
command = "worktrunk.remove"
description = "Worktree: remove"

[[keys.command]]
key = "prefix+y"
type = "plugin_action"
command = "ray.file-explorer.open"
description = "File explorer: open in split"

[[keys.command]]
key = "prefix+shift+y"
type = "plugin_action"
command = "ray.file-explorer.open-tab"
description = "File explorer: open in new tab"

[[keys.command]]
key = "prefix+b"
type = "shell"
command = '"${HERDR_BIN_PATH}" plugin pane open --plugin official.browser --entrypoint browser --placement split --direction right --focus'
description = "Browser: open in right split"

[[keys.command]]
key = "prefix+shift+b"
type = "shell"
command = '"${HERDR_BIN_PATH}" plugin pane open --plugin official.browser --entrypoint browser --placement overlay --focus'
description = "Browser: open overlay"

[[keys.command]]
key = "prefix+t"
type = "plugin_action"
command = "herdr-navigator.open"
description = "Navigator: jump to anything"

[[keys.command]]
key = "prefix+tab"
type = "plugin_action"
command = "herdr-navigator.jump-back"
description = "Navigator: jump to previous workspace"

[[keys.command]]
key = "prefix+i"
type = "shell"
command = '"${HERDR_BIN_PATH}" plugin pane open --plugin herdr-agent-inbox --entrypoint inbox'
description = "Agent inbox: open"

[[keys.command]]
key = "prefix+m"
type = "plugin_action"
command = "herdr-agent-inbox.settle"
description = "Agent inbox: settle agent"

[[keys.command]]
key = "prefix+shift+m"
type = "plugin_action"
command = "herdr-agent-inbox.unread"
description = "Agent inbox: mark unread"

[[keys.command]]
key = "prefix+f"
type = "plugin_action"
command = "herdr-file-viewer.open-file-viewer"
description = "Files: open read-only viewer in split"

[[keys.command]]
key = "prefix+shift+f"
type = "plugin_action"
command = "herdr-file-viewer.open-file-viewer-tab"
description = "Files: open read-only viewer in tab"

[[keys.command]]
key = "prefix+u"
type = "plugin_action"
command = "gh-pr.open-pr"
description = "GitHub: open current branch PR"

[[keys.command]]
key = "prefix+space"
type = "plugin_action"
command = "ramarivera.pretty-which.open"
description = "Keybindings: searchable training overlay"

[ui.sidebar.agents]
rows = [
  ["state_icon", "$title", "$pr"],
  [{ token = "$flag", fg = "#e0af68", bold = true }, "agent", "workspace", { token = "$age", dim = true }],
  ["$task"],
  ["$status"],
]

[ui.sidebar.spaces]
rows = [
  ["state_icon", "workspace", "$agents", { token = "$busy", dim = true }],
  ["branch", "git_status"],
]
# END CHEZMOI: herdr plugins
EOF
