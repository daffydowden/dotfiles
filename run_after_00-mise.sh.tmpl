{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -euo pipefail

# mise config hash: {{ include "private_dot_config/mise/config.toml" | sha256sum }}
if ! command -v mise >/dev/null 2>&1; then
  printf 'chezmoi: mise is not installed; package setup may have failed\n' >&2
  exit 1
fi

# This script is prefixed 00 because later after-scripts may need Cargo, Pi,
# Node, or another runtime supplied by Mise on a fresh machine. Every configured
# tool follows latest, so check for upstream releases on every apply.
mise install

# Mise's Pi backend changed its archive layout from pi to pi/pi without a
# version bump. An existing installation can therefore satisfy `mise install`
# while its executable no longer matches current backend metadata.
if ! mise exec -- pi --version >/dev/null 2>&1; then
  printf 'chezmoi: repairing Pi installation after a Mise layout change\n'
  mise install --force pi@latest
fi
{{ end -}}
