{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -euo pipefail

# Secrets now live only in individual shell processes. Remove values persisted
# by the old Fish universal-variable loader.
if command -v fish >/dev/null 2>&1; then
  # $key belongs to the Fish program.
  # shellcheck disable=SC2016
  fish -c 'for key in OPENAI_API_KEY ANTHROPIC_API_KEY DEEPSEEK_API_KEY OPENROUTER_API_KEY GOOGLE_AI_API_KEY GROQ_API_KEY; set -e -U $key; end; true'
fi

# Older work-machine configs cached these three vault values in chezmoi.toml.
config_file={{ .chezmoi.configFile | quote }}
if [[ -f "$config_file" ]]; then
  perl -ni -e 'print unless /^\s*(?:src_access_token|jira_token|litellm_api_key)\s*=/' "$config_file"
fi
{{ end -}}
