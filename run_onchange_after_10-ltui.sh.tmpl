{{- if and (eq .chezmoi.os "darwin") .is_work -}}
#!/usr/bin/env bash
set -euo pipefail

if ! command -v mise >/dev/null 2>&1; then
  printf 'chezmoi: mise is required to install ltui\n' >&2
  exit 1
fi

# Upstream supports uv tool installs directly from the ltui subdirectory. Using
# mise here also works during a fresh chezmoi apply, before a new shell has added
# the mise shims to PATH.
mise exec -- uv tool install --force \
  'git+https://github.com/runpantheon/ltui@9722b5fb6ba07c9f31cecb2375018ba32e5d6731#subdirectory=ltui'
{{ end -}}
