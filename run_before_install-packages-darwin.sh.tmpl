{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -euo pipefail

if ! command -v brew >/dev/null 2>&1; then
  printf 'chezmoi: Homebrew is required before package installation\n' >&2
  exit 1
fi

sudo_keepalive_pid=""
stop_sudo_keepalive() {
  if [[ -n "$sudo_keepalive_pid" ]]; then
    kill "$sudo_keepalive_pid" >/dev/null 2>&1 || true
    wait "$sudo_keepalive_pid" 2>/dev/null || true
  fi
}
trap stop_sudo_keepalive EXIT

if [[ -t 0 && -t 1 ]]; then
  printf '%s\n' \
    'chezmoi: Homebrew may need administrator access to upgrade macOS apps.' \
    'chezmoi: Legacy Homebrew apps in ~/Applications will move to /Applications.' \
    'chezmoi: If you continue, the next prompt asks for your macOS login password' \
    'chezmoi: (not a GitHub, 1Password, or work credential).'
  read -r -p 'Pre-authorize Homebrew updates now? [y/N] ' authorize_homebrew
  case "$authorize_homebrew" in
    y|Y|yes|YES)
      export SUDO_PROMPT='chezmoi/Homebrew needs your macOS login password for privileged app updates: '
      sudo -v
      while sudo -n true 2>/dev/null; do
        sleep 50
      done &
      sudo_keepalive_pid=$!
      ;;
    *)
      printf 'chezmoi: Homebrew updates cancelled before package changes\n' >&2
      exit 1
      ;;
  esac
else
  printf '%s\n' \
    'chezmoi: non-interactive Homebrew run; privileged cask updates may require' \
    'chezmoi: a pre-existing sudo credential.' >&2
fi

# Homebrew remembers the cask options used for each original installation, so
# removing the old global ~/Applications option from the Brewfile did not move
# existing apps. Reinstall only apps managed by this Brewfile whose receipts
# still explicitly select that legacy directory. This preserves application
# data and leaves user-scoped cask artifacts such as fonts alone.
legacy_appdir="$HOME/Applications"
managed_app_casks=(
  kitty
  ghostty
  cmux
  utm
  google-chrome
  brave-browser
  datagrip
  visual-studio-code
  sublime-text
  obsidian
  bruno
  rectangle
  {{ if not .is_work -}}
  1password
  {{- end }}
  spotify
  lm-studio
  positron
  zed
  codex
  codex-app
  claude
  {{ if .is_work -}}
  slack
  {{- end }}
)
caskroom="$(brew --caskroom)"
for cask in "${managed_app_casks[@]}"; do
  cask_config="$caskroom/$cask/.metadata/config.json"
  [[ -f "$cask_config" ]] || continue
  installed_appdir="$(
    /usr/bin/plutil -extract explicit.appdir raw -o - "$cask_config" 2>/dev/null || true
  )"
  [[ "$installed_appdir" == "$legacy_appdir" ]] || continue

  printf 'chezmoi: migrating Homebrew cask %s to /Applications\n' "$cask"
  brew reinstall --cask --appdir=/Applications --no-ask "$cask"
done

# Current Homebrew requires an explicit trust decision before loading formulae
# from third-party taps. These are the same taps declared in the Brewfile below.
for tap in \
  trycua/lume \
  d12frosted/emacs-plus \
  charmbracelet/tap \
  {{ if .is_work -}}
  schpet/tap
  {{- else -}}
  openhue/cli
  {{- end }}; do
  brew trust "$tap"
done

# Retire the link ownership from the previous Emacs distribution without
# uninstalling it; this is reversible with `brew link emacs-mac@29`.
if brew list --formula emacs-mac@29 >/dev/null 2>&1; then
  brew unlink emacs-mac@29
fi

# Brew Bundle installs and upgrades by default. Run it on every apply so the
# unversioned formulae and casks continue following their latest releases.
brew bundle --file=/dev/stdin <<'BREWFILE'
{{ template "Brewfile.tmpl" . -}}
BREWFILE
{{ end -}}
