{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -euo pipefail

if ! command -v brew >/dev/null 2>&1; then
  printf 'chezmoi: Homebrew is required before package installation\n' >&2
  exit 1
fi

if [[ -t 0 && -t 1 ]]; then
  printf '%s\n' \
    'chezmoi: Some Homebrew casks remove privileged macOS launch services.' \
    'chezmoi: Legacy Homebrew apps in ~/Applications will move to /Applications.' \
    'chezmoi: If Homebrew prints "Password:", enter your macOS login password' \
    'chezmoi: (not a GitHub, 1Password, Apple Account, or work credential).'
  read -r -p 'Run Homebrew installs, migrations, and updates now? [y/N] ' authorize_homebrew
  case "$authorize_homebrew" in
    y|Y|yes|YES) ;;
    *)
      printf 'chezmoi: Homebrew updates cancelled before package changes\n' >&2
      exit 1
      ;;
  esac
else
  printf '%s\n' \
    'chezmoi: non-interactive Homebrew run; a cask that removes privileged' \
    'chezmoi: launch services may require an existing sudo credential.' >&2
fi

# Homebrew remembers the cask options used for each original installation, so
# removing the old global ~/Applications option from the Brewfile did not move
# existing apps. Reinstall only apps managed by this Brewfile whose receipts
# still explicitly select that legacy directory. This preserves application
# data and leaves user-scoped cask artifacts such as fonts alone.
legacy_appdir="$HOME/Applications"
managed_app_casks=(
  kitty
  ghostty
  cmux
  utm
  google-chrome
  brave-browser
  datagrip
  visual-studio-code
  sublime-text
  obsidian
  bruno
  rectangle
  {{ if not .is_work -}}
  1password
  {{- end }}
  spotify
  lm-studio
  positron
  zed
  codex
  codex-app
  claude
  {{ if .is_work -}}
  slack
  {{- end }}
)
caskroom="$(brew --caskroom)"
legacy_app_casks=()
for cask in "${managed_app_casks[@]}"; do
  cask_config="$caskroom/$cask/.metadata/config.json"
  [[ -f "$cask_config" ]] || continue
  installed_appdir="$(
    /usr/bin/plutil -extract explicit.appdir raw -o - "$cask_config" 2>/dev/null || true
  )"
  [[ "$installed_appdir" == "$legacy_appdir" ]] || continue
  legacy_app_casks+=("$cask")
done
if ((${#legacy_app_casks[@]})); then
  printf 'chezmoi: migrating Homebrew casks to /Applications: %s\n' \
    "${legacy_app_casks[*]}"
  # Keep every migration in one Homebrew process so sudo can reuse a single
  # credential when multiple casks remove privileged launch services.
  brew reinstall --cask --appdir=/Applications --no-ask "${legacy_app_casks[@]}"
fi

# Current Homebrew requires an explicit trust decision before loading formulae
# from third-party taps. These are the same taps declared in the Brewfile below.
for tap in \
  trycua/lume \
  d12frosted/emacs-plus \
  charmbracelet/tap \
  {{ if .is_work -}}
  schpet/tap
  {{- else -}}
  openhue/cli
  {{- end }}; do
  brew trust "$tap"
done

# Retire the link ownership from the previous Emacs distribution without
# uninstalling it; this is reversible with `brew link emacs-mac@29`.
if brew list --formula emacs-mac@29 >/dev/null 2>&1; then
  brew unlink emacs-mac@29
fi

# Install missing dependencies declaratively, then upgrade the managed formulae
# and casks in type-specific batches. A single cask upgrade process can reuse
# one sudo credential across privileged launch-service cleanup operations.
brewfile_path="$(mktemp "${TMPDIR:-/tmp}/chezmoi-brewfile.XXXXXX")"
cleanup_brewfile() {
  rm -f "$brewfile_path"
}
trap cleanup_brewfile EXIT
cat >"$brewfile_path" <<'BREWFILE'
{{ template "Brewfile.tmpl" . -}}
BREWFILE

brew bundle --no-upgrade --file="$brewfile_path"

managed_formulae=()
while IFS= read -r formula; do
  [[ -n "$formula" ]] && managed_formulae+=("$formula")
done < <(brew bundle list --formula --file="$brewfile_path")
if ((${#managed_formulae[@]})); then
  brew upgrade --formula --no-ask "${managed_formulae[@]}"
fi

managed_casks=()
while IFS= read -r cask; do
  [[ -n "$cask" ]] && managed_casks+=("$cask")
done < <(brew bundle list --cask --file="$brewfile_path")
if ((${#managed_casks[@]})); then
  # A cask reinstallation can leave its former app bundle as an empty
  # directory in ~/Applications. Derive app names from Homebrew metadata and
  # remove only empty legacy paths that have a live counterpart in
  # /Applications; user-installed bundles and non-empty directories are left
  # untouched.
  legacy_app_names=()
  while IFS= read -r app_name; do
    [[ -n "$app_name" ]] && legacy_app_names+=("$app_name")
  done < <(
    brew info --json=v2 --cask "${managed_casks[@]}" |
      jq -r '.casks[].artifacts[]? | .app? // empty | .[0]'
  )
  for app_name in "${legacy_app_names[@]}"; do
    legacy_path="$legacy_appdir/$app_name"
    current_path="/Applications/$app_name"
    if [[ -d "$current_path" && -d "$legacy_path" && ! -L "$legacy_path" ]] &&
      rmdir "$legacy_path" 2>/dev/null; then
      printf 'chezmoi: removed empty legacy app bundle: %s\n' "$legacy_path"
    fi
  done

  brew upgrade --cask --appdir=/Applications --no-ask "${managed_casks[@]}"
fi
{{ end -}}
